{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=identity.db"
  },
  "Jwt": {
    "Issuer": "https://identity.local",
    "Audience": "sharehouse-clients",
    "SigningKey": "super-secret-development-key-change-me",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  }
}
