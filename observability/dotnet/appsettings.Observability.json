{
  "Observability": {
    "OpenTelemetry": {
      "ServiceName": "ShareHouse.Api",
      "ServiceVersion": "1.0.0",
      "ServiceNamespace": "share-house",
      "DeploymentEnvironment": "production",
      "OtlpEndpoint": "http://otel-collector.observability.svc.cluster.local:4317",
      "OtlpHeaders": "DD-API-KEY=${DATADOG_API_KEY};api-key=${NEW_RELIC_LICENSE_KEY}",
      "EnableConsoleExporter": false
    },
    "CloudWatch": {
      "Region": "us-east-1",
      "LogGroup": "/eks/share-house/api",
      "LogStreamPrefix": "share-house-api",
      "RetentionInDays": 30,
      "FlushPeriodSeconds": 5,
      "BatchSizeLimit": 100,
      "QueueSizeLimit": 10000,
      "MinimumLevel": "Information"
    }
  }
}
